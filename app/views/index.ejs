<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= myname %></h1>
    <h2><%= title %></h2>

    <ul>
        <% definitions.forEach(function(item) { %>
            <li>
                <strong><%= item.name %>:</strong>
                <%= item.definition %>
            </li>
        <% }); %>
    </ul>
</body>
</html>